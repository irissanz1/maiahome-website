# Token de lectura de Sanity (para leer borradores). NO commitear .env.local
SANITY_API_TOKEN=
# Analítica (opcional; si vacío, no carga nada)
NEXT_PUBLIC_GA_ID=          # ej. G-XXXXXXX (GA4 Measurement ID)
NEXT_PUBLIC_META_PIXEL_ID=  # ej. 1234567890 (Meta Pixel ID)
# Webhook de Zoho Flow "Propietarios sitio - CRM" (crea el Prospecto en Zoho CRM).
# Se copia desde Zoho Flow > Propietarios sitio - CRM > Webhook > Copy.
# Si queda vacío, el formulario sigue funcionando y el prospecto queda en los logs.
ZOHO_OWNER_LEAD_URL=
